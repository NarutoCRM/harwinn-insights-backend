# NODE_ENV=development
# PORT=3000
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/harwinn?schema=public
# DATABASE_URL="postgresql://postgres:harwinninsights@9095@localhost:5432/harwinn"

# # Minimum 32 random characters; also used to digest bearer tokens.
# AUTH_SECRET=
# SESSION_TTL_HOURS=8
# # Explicit proxy IPs/CIDRs only; empty means no proxy is trusted.
# TRUST_PROXY=
# # Our API contract defaults, not assumed client parameter names.
# REDIRECT_PARAM_MAP={"uid":"uid","transactionId":"transactionId","username":"username","inTime":"inTime"}
# # Optional HTTPS URL per outcome; substitutions: {pid}, {uid}, {status}, {transactionId}
# OUTCOME_URLS={}
# # Development seed requires both values, creates no projects or default credentials.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# # Optional disposable PostgreSQL database for integration tests.
# TEST_DATABASE_URL=

